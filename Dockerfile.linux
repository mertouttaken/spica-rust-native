# Production Linux x86_64 build (spica-launcher + libspica_rust_native.so + SpicaRustNative-2.4.0.jar)
# Kullanim:
#   docker build -f Dockerfile.linux --output type=local,dest=./dist/linux-x86_64 .

FROM rust:1.83-bookworm AS rust-builder
WORKDIR /build
COPY Cargo.toml ./
COPY spica-native ./spica-native
COPY spica-launcher ./spica-launcher
ENV RUSTFLAGS="-C target-cpu=x86-64-v3"
RUN cargo test --workspace --release && cargo build --workspace --release

FROM maven:3.9-eclipse-temurin-21 AS java-builder
WORKDIR /build/plugin
COPY spica-rust-native-plugin/pom.xml ./
COPY spica-rust-native-plugin/src ./src
COPY --from=rust-builder /build/target/release/libspica_rust_native.so \
     src/main/resources/native/linux-x86_64/libspica_rust_native.so
RUN mvn -B clean package

FROM scratch AS export
COPY --from=java-builder /build/plugin/target/SpicaRustNative-2.4.0.jar /SpicaRustNative-2.4.0.jar
COPY --from=rust-builder /build/target/release/spica-launcher /spica-launcher
COPY --from=rust-builder /build/target/release/libspica_rust_native.so /libspica_rust_native.so
